# ==============================================================================
# DEPENDENCIAS
# ==============================================================================
node_modules/
.pnp/
.pnp.js

# ==============================================================================
# ENTORNO Y SECRETOS (Crucial para evitar filtraciones y conflictos en server)
# ==============================================================================
# Ignora cualquier archivo .env local (.env, .env.local, .env.development, etc.)
.env
.env.*
!.env.example

# ==============================================================================
# BASE DE DATOS LOCAL
# ==============================================================================
# Base de datos PostgreSQL embebida / local
.postgres-data/
postgres-data/
*.pid

# Bases de datos SQLite o volcados locales (si se generan)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.dump

# ==============================================================================
# NEXT.JS Y COMPILACIÓN (Para evitar conflictos en git pull en server)
# ==============================================================================
.next/
out/
build/
dist/
.vercel/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# ==============================================================================
# ARCHIVOS TEMPORALES, LOGS Y TOKENS LOCALES
# ==============================================================================
*.log
*.log*
logfile
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Tokens, cookies o credenciales de pruebas locales
cookies.txt
cookie*.txt
*.tmp
*.bak

# Scripts de prueba y soporte estrictamente locales
start-db.js
test-*.js
check-*.js
delete-*.js
set-admin.js

# ==============================================================================
# SISTEMA OPERATIVO Y METADATOS
# ==============================================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# ==============================================================================
# EDITORES E IDES
# ==============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==============================================================================
# AGENTES DE IA Y WORKSPACES LOCALES
# ==============================================================================
.rsc/
.rsc.json
.worktrees/
