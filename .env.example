# Copia este archivo a .env y reemplaza con la URL real de tu Postgres.
DATABASE_URL="postgresql://usuario:password@localhost:5432/outlet_autocorp_evento?schema=public"

# Autenticación JWT — genera secretos distintos y largos, ej:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-largo-y-aleatorio-distinto"

# El refresh token expira en esta fecha (fin del evento), no por duración fija.
EVENT_END_DATE="2026-11-30T23:59:59-06:00"
